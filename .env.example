# Copia este archivo a .env y completa los valores reales.
# .env NUNCA se sube a Git (ver .gitignore).

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Formato: usuario1:hash_bcrypt1,usuario2:hash_bcrypt2
# Genera cada hash con: python scripts/generar_hash.py
DASHBOARD_USERS=

# Ruta a la base de datos construida por build_data.py
MART_DB_PATH=data/mart.db

# Nombre a mostrar en la interfaz
CLIENTE_NOMBRE=mixtwo

APP_DEBUG=false
